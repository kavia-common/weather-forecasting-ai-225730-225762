# Non-secret environment variables for the frontend (React)
# Do not put secrets or API keys here.

# Base URL for backend APIs (choose one). Examples:
# REACT_APP_API_BASE=https://api.example.com
# REACT_APP_BACKEND_URL=https://backend.example.com
REACT_APP_API_BASE=
REACT_APP_BACKEND_URL=

# Optional environment hints
REACT_APP_NODE_ENV=development
REACT_APP_PORT=3000
REACT_APP_FEATURE_FLAGS=
REACT_APP_FRONTEND_URL=
REACT_APP_WS_URL=
REACT_APP_TRUST_PROXY=false
REACT_APP_LOG_LEVEL=info
REACT_APP_HEALTHCHECK_PATH=/health
REACT_APP_ENABLE_SOURCE_MAPS=true
REACT_APP_EXPERIMENTS_ENABLED=false
REACT_APP_NEXT_TELEMETRY_DISABLED=1
